# Lightweight, CPU-only image. Unlike the default Dockerfile, this has no CUDA
# base image, so it builds and runs natively on any platform pip/Docker
# supports - including Apple Silicon (arm64) Macs, with no emulation needed.
FROM python:3.11-slim

WORKDIR /app

# System dependencies for building the Rust core (a C linker) and GDAL (rasterio)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential \
    cmake \
    gdal-bin \
    libgdal-dev \
    git \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (stable) to build zeit's compiled core
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

RUN pip install --upgrade pip

COPY . .

# CPU-only PyTorch wheel, so we don't pull in unused CUDA runtime libraries
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu

# Install JupyterLab for interactive data science
RUN pip install jupyterlab

# Install the package in editable mode (compiles the Rust core), with zeit.ai's extra
RUN pip install -e ".[ai]"

# Expose Jupyter port for interactive sessions
EXPOSE 8888

# Default command: start a Jupyter server
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
